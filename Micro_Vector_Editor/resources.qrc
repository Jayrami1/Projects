<!DOCTYPE RCC>
<RCC version="1.0">
  <qresource prefix="/icons">
   <!-- we needed qrc file inorder to tell cmake by Qt resource file that icons are in this directory and can be accessed by this path -->
    <file alias="hex.svg">icons/hex.svg</file>
    <file alias="circle.svg">icons/circle.svg</file>
    <file alias="line.svg">icons/line.svg</file>
    <file alias="rectangle.svg">icons/rectangle.svg</file>
    <file alias="freehand.svg">icons/freehand.svg</file>
    <file alias="colorfill.svg">icons/colorfill.svg</file>
    <file alias="text.svg">icons/text.svg</file>
    <file alias="close.svg">icons/close.svg</file>
    <file alias="save.svg">icons/save.svg</file>
    <file alias="saveas.svg">icons/saveas.svg</file>
    <file alias="open.svg">icons/open.svg</file>
    <file alias="new.svg">icons/new.svg</file>
    <file alias="cut.svg">icons/cut.svg</file>
    <file alias="copy.svg">icons/copy.svg</file>
    <file alias="paste.svg">icons/paste.svg</file>
    <file alias="select.svg">icons/select.svg</file>
    <file alias="undo.svg">icons/undo.svg</file>
    <file alias="redo.svg">icons/redo.svg</file>
    <file alias="delete.svg">icons/delete.svg</file>
    <file alias="stroke.png">icons/stroke.png</file>
    
  </qresource>
</RCC>
